# The repo is edited on Windows but the benchmark runs on Linux
# (/home/kenton/projects/memora). Without this, core.autocrlf=true rewrites shell scripts
# and config files with CRLF endings, and then:
#
#   bash scripts/setup_server.sh   ->  "$'\r': command not found"
#   redis-server /...conf          ->  silently misparsed directives
#
# Force LF on everything that a Linux tool executes or parses.

*.sh    text eol=lf
*.conf  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.py    text eol=lf

# Treat the dataset as data, never line-ending-converted.
*.json  text eol=lf
data/** -text
