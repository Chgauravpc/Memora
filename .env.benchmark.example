# Benchmark environment. Copy to .env on the server and fill in the keys:
#     cp .env.benchmark.example .env
#
# src/config.py loads .env from the repo root at import time, so everything here is
# picked up by both Memora and the benchmark harness.

# ---------------------------------------------------------------- backends
# Ports are also read by docker-compose.benchmark.yml, so the two stay in sync.
# Change these if something already occupies 6379/6333 on the server.
REDIS_HOST=localhost
REDIS_PORT=6379
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# REDIS_DB and QDRANT_COLLECTION are set PER WORKER by benchmarks/runner.py.
# Do not pin them here - a fixed value would make every worker share one store and
# silently cross-contaminate conversations.
# REDIS_DB=0
# QDRANT_COLLECTION=memory_vectors

# ------------------------------------------------- extraction (Stage 3, inside Memora)
LLM_PROVIDER=groq
LLM_EXTRACTION_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------- reader + judge (benchmark only)
# Kept separate from extraction so the system under test and the grader can differ.
BENCH_LLM_PROVIDER=groq
BENCH_LLM_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------- API keys
# Groq rate limits are PER ACCOUNT, not per key. Extra keys only help if they belong to
# separate accounts. Stage 3 fires on most turns for out-of-domain text, so on a 32-core
# box the run is rate-limit bound long before it is CPU bound -- more accounts is the
# single most effective speedup.
GROQ_API_KEY=
# GROQ_API_KEY_1=
# GROQ_API_KEY_2=

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --------------------------------------------------- OPTION: local model on CPU
# To run extraction against a locally-served model instead of a hosted API, start a
# server (scripts/serve_local_model.sh) and set the three variables below. No code change
# is needed: the OpenAI SDK reads OPENAI_BASE_URL from the environment, so Memora's
# Stage 3 "openai" provider will talk to localhost.
#
# Keep BENCH_LLM_PROVIDER=groq above while doing this. That is the recommended split:
# extraction (the bulk of the calls, and a component of the system under test) runs
# locally and free; the reader and especially the JUDGE stay on a strong hosted model,
# because judge quality moves the headline score directly and a small local judge would
# add grading noise to the number you are trying to report.
#
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=http://127.0.0.1:8080/v1
# OPENAI_API_KEY=local
# LLM_EXTRACTION_MODEL=qwen3-30b-a3b
#
# Changing the extraction model changes the system under test. The default is
# llama-3.3-70b-versatile on Groq; a local Qwen3-30B-A3B measures Memora+Qwen3-30B, which
# is a legitimate configuration but must be reported as such.

# ---------------------------------------------------------------- run sizing
# Workers each own one Redis logical DB. redis.benchmark.conf sets `databases 64`.
# LoCoMo has only 10 conversations, so 10 is the useful ceiling regardless of core count.
BENCH_WORKERS=10
BENCH_MAX_REDIS_DBS=64

# NUMA pinning for the benchmark processes. On the dual-socket target box, put the
# benchmark on node0 and a locally-served model on node1 (NUMA_NODE=1 for
# scripts/serve_local_model.sh) so the two never compete for DRAM bandwidth -- the
# binding resource for CPU inference. Leave unset to let the scheduler decide.
# BENCH_NUMA_NODE=0

# Memora logs a banner per turn at INFO; WARNING keeps the logs readable at scale.
LOG_LEVEL=WARNING
