# Memory System Configuration

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Qdrant Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=memory_vectors

# LLM Provider Configuration
# Options: "openai" | "anthropic" | "groq"
LLM_PROVIDER=groq
LLM_EXTRACTION_MODEL=llama-3.3-70b-versatile

# API Keys
# OpenAI (if using LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-your-key-here

# Anthropic (if using LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Groq (if using LLM_PROVIDER=groq)
# Single API key:
GROQ_API_KEY=gsk-your-key-here

# Multiple API keys for rate limit rotation (requires different accounts):
# GROQ_API_KEY_1=gsk-your-first-key-here
# GROQ_API_KEY_2=gsk-your-second-key-here

# Note: 
# - Rate limits are per account, not per key
# - To use multiple keys effectively, create separate Groq accounts
# - The system will automatically rotate keys when hitting 429 rate limit errors
# - You can use GROQ_API_KEY alone, or _1 and _2 together
# - Up to 3 keys supported: GROQ_API_KEY, GROQ_API_KEY_1, GROQ_API_KEY_2

# Logging
LOG_LEVEL=INFO
